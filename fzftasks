#!/usr/bin/bash

curlval=$(curl -s 'localhost:8080/get_all_lists/1' | jq)

titlearry=()
idarry=()
concatarry=()
iterator=0

# Parse the list of tasks
#
#Turn into function
parse_lists() {
    for i in $(echo "$curlval" | jq -r '.[] | @base64'); do
        _jq() {
            echo ${i} | base64 --decode | jq -r ${1}
        }

        title=$(_jq '.title')
        id=$(_jq '.id')
        titlearry+=("$title")
        idarry+=("$id")
        concatarry+=("$iterator $title $id")
        iterator=$((iterator + 1))
    done
}

parse_lists
